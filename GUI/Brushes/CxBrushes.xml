<Brushes>
  <!-- Calradic Exchange: small colored row buttons of the trade tables (CxTradeTable.xml). -->
  <Brush Name="Cx.RowButton.Base">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#FFFFFFFF" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.35" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.5" AlphaFactor="0.5" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="panels/next" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <Brush Name="Cx.RowButton.Buy" BaseBrush="Cx.RowButton.Base">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#4C7A2CFF" />
    </Layers>
  </Brush>

  <Brush Name="Cx.RowButton.Sell" BaseBrush="Cx.RowButton.Base">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#8E3A33FF" />
    </Layers>
  </Brush>

  <Brush Name="Cx.RowButton.Order" BaseBrush="Cx.RowButton.Base">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#9A6A2CFF" />
    </Layers>
  </Brush>
</Brushes>
