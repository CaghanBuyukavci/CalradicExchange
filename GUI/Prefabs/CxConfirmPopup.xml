<Prefab>
  <!-- Calradic Exchange: buy / sell confirmation. Heading, then label | value rows (GridRowVM C1, C2, Color2; IsAlternate = total row). Data source: ConfirmVM. -->
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000ff" AlphaFactor="0.7">
      <Children>

        <DimensionSyncWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" DimensionToSync="Vertical" WidgetToCopyHeightFrom="ConfirmContent">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas" />

            <ListPanel Id="ConfirmContent" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="620" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56" MarginTop="8" Brush="Popup.Title.Text" Text="@Title" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="23" Sprite="StdAssets\Popup\divider" />

                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="40" MarginRight="40" MarginTop="6" MarginBottom="12" Brush="Popup.Description.Text" Brush.FontSize="22" Brush.FontColor="#E4C59BFF" Text="@Heading" />

                <ListPanel DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="40" MarginRight="40" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <ItemTemplate>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#E4C59BFF" AlphaFactor="0.12" IsVisible="@IsAlternate" />
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="12" Brush="Popup.Description.Text" Brush.FontSize="20" Brush.TextHorizontalAlignment="Left" Brush.FontColor="@Color1" Text="@C1" />
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="12" Brush="Popup.Description.Text" Brush.FontSize="20" Brush.TextHorizontalAlignment="Right" Brush.FontColor="@Color2" Text="@C2" />
                      </Children>
                    </Widget>
                  </ItemTemplate>
                </ListPanel>

                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="64" HorizontalAlignment="Center" MarginTop="24" MarginBottom="20" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="240" SuggestedHeight="64" MarginRight="10" Brush="Popup.Cancel.Button" Command.Click="ExecuteCancel">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" VerticalAlignment="Center" MarginLeft="30" MarginRight="30" Brush="Popup.Button.Text" Text="@CancelText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="240" SuggestedHeight="64" MarginLeft="10" Brush="Popup.Done.Button" Command.Click="ExecuteConfirm">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" VerticalAlignment="Center" MarginLeft="30" MarginRight="30" Brush="Popup.Button.Text" Text="@ConfirmText" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>

              </Children>
            </ListPanel>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="18" ExtendTop="18" ExtendRight="18" ExtendBottom="18" IsEnabled="false" />
          </Children>
        </DimensionSyncWidget>
      </Children>
    </Widget>
  </Window>
</Prefab>
